# Faro — environment variables. Copy to `.env.local` and fill in.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.

# --- Supabase (added in M1) ---
# Project URL and anon key are safe to expose to the client (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key is SECRET — server-side only, never NEXT_PUBLIC_*.
# Used by migrations / privileged server routes. Bypasses RLS — handle with care.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI triage (self-hosted, server-side only, ZERO API cost) ---
# Runs against a local Ollama instance. Leave unset and the feature simply stays
# hidden — the dashboard works without it. To enable:
#   1. Install Ollama (https://ollama.com)
#   2. `ollama pull qwen2.5:7b`  (any instruct model good at Spanish works)
#   3. Point OLLAMA_URL at it (default below works if Ollama runs on the same box)
# AI only SUGGESTS; a coordinator always verifies (Golden Rule #3).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Routing / ETA (self-hosted, server-side only, ZERO API cost) ---
# OSRM gives responders road distance + ETA to each need. Leave unset and the
# ETA badge just doesn't show. To enable (Docker):
#   1. Download a Venezuela extract: https://download.geofabrik.de/south-america/venezuela-latest.osm.pbf
#   2. osrm-extract / osrm-partition / osrm-customize, then `osrm-routed`
#   3. Point OSRM_URL at it. NOTE: routes the pre-quake road network, so ETAs
#      are best-guess and shown with a "~" (Golden Rule #5).
OSRM_URL=http://localhost:5000

# --- SMS intake (DEFERRED — not built) ---
# The only Phase 2 item that can't be free/self-hosted: carriers charge per
# message and require a registered account + number. The PWA + offline outbox
# already cover smartphone users with no live connection, so SMS is left
# unbuilt rather than scaffolded. It earns its keep only for feature-phone /
# no-data-plan users. To add later: a gateway account (Twilio or a local
# aggregator) + an inbound webhook route that enqueues to the same `needs`
# table. Add these vars then:
#   SMS_WEBHOOK_SECRET=        # verify inbound webhooks are really from the gateway
#   SMS_GATEWAY_TOKEN=         # gateway API credential (SECRET, server-side only)

# --- App ---
# Public base URL of the deployment (used for absolute links / manifest).
NEXT_PUBLIC_APP_URL=http://localhost:3000
