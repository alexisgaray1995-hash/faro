# Faro — environment variables. Copy to `.env.local` and fill in.
# NEVER commit real secrets. Only NEXT_PUBLIC_* values reach the browser.

# --- Supabase (added in M1) ---
# Project URL and anon key are safe to expose to the client (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key is SECRET — server-side only, never NEXT_PUBLIC_*.
# Used by migrations / privileged server routes. Bypasses RLS — handle with care.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic / AI layer (added in Phase 2, server-side only) ---
# Never expose to the client. AI is off by default until a coordinator enables it.
ANTHROPIC_API_KEY=

# --- App ---
# Public base URL of the deployment (used for absolute links / manifest).
NEXT_PUBLIC_APP_URL=http://localhost:3000
